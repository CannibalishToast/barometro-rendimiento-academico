      "name": "RF-01 Materias",
      "item": [
        {
          "name": "CP-12 Registrar materia válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/materias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "materias"
              ]
            },
            "description": "CA-01.1. Registra una materia nueva y guarda su id en la variable materiaNueva (la usan CP-25, CP-01, CP-02 y siguientes).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cálculo Integral\",\n  \"docente\": \"Docente de prueba QA\",\n  \"horario\": {\n    \"dias\": [\n      \"LUNES\",\n      \"MIERCOLES\"\n    ],\n    \"horaInicio\": \"08:00\",\n    \"horaFin\": \"10:00\"\n  },\n  \"salon\": \"B-204\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const m = pm.response.json();",
                  "pm.test(\"Devuelve la materia con su id\", () => pm.expect(m.id).to.be.a(\"number\"));",
                  "pm.test(\"Devuelve los datos enviados\", () => {",
                  "  pm.expect(m.nombre).to.eql(\"Cálculo Integral\");",
                  "  pm.expect(m.salon).to.eql(\"B-204\");",
                  "});",
                  "pm.collectionVariables.set(\"materiaNueva\", m.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-14 Consultar materias del estudiante",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/materias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "materias"
              ]
            },
            "description": "CA-01.3. La lista debe incluir la materia de CP-12 y las 5 materias de los datos de prueba (SCRUM-38)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test(\"La lista incluye la materia registrada en CP-12\", () =>",
                  "  pm.expect(lista.map(m => m.id)).to.include(Number(pm.collectionVariables.get(\"materiaNueva\"))));",
                  "pm.test(\"Incluye los datos de prueba (al menos 6 materias)\", () => pm.expect(lista.length).to.be.at.least(6));"
                ]
              }
            }
          ]
        },
